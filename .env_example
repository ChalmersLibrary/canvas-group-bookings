# Copy to .env and fill in. Values here are placeholders, not defaults to keep.

# development enables debug logging and the mocked LTI launch, and leaves the session cookie
# unrestricted so it works over plain http. production is required anywhere the tool is framed
# by Canvas, because the cookie then needs Secure and SameSite=None to be stored at all.
NODE_ENV="development"
PORT=3000

# Read by the Postgres driver itself, not by this application, which is why they appear
# nowhere in the source. PGPORT defaults to 5432.
PGUSER=""
PGPASSWORD=""
PGHOST=""
PGPORT=5432
PGDATABASE=""

SESSION_NAME="ExampleSID"
SESSION_SECRET="CatIsMouseOrIsItDogMaybeCat"

# The Canvas developer key, and the Canvas it belongs to. AUTH_HOST is read once at startup, so
# one deployment serves exactly one Canvas. It is also part of the key tokens are stored under:
# changing it makes every stored token unreachable until the rows are re-keyed to match.
AUTH_CLIENT_ID=""
AUTH_CLIENT_SECRET=""
AUTH_HOST="https://canvas.example.com"
AUTH_REDIRECT_CALLBACK="http://localhost:3000/callback"

# Optional, and falls back to AUTH_HOST. A Canvas instance serves its api and its login on the
# same host, so setting this means keeping two variables in step for no gain.
#API_HOST=""

# LTI consumer keys and shared secrets: <key>:<secret>[,<key>:<secret>,...]
LTI_KEYS="xxx:secret"

# A launch states which Canvas it came from. Mismatches are reported at info level always; set
# this only once the log has shown the reported domain and AUTH_HOST agree, because refusing on a
# mismatch locks out everybody and the tool has no other way in.
#LTI_ENFORCE_API_DOMAIN=false
#LTI_ALLOWED_API_DOMAINS=""

# Stores the shard-qualified global id as the user key for users whose global id starts with this,
# so ids from another Canvas shard cannot collide with local ones. Leave unset if unsure.
#USERID_PREFIX_FORCE_GLOBAL_ID=""

# Which sites may embed the tool. Space separated, since a CSP source list is; a comma is read as
# part of one malformed source and everything after it is ignored. Must name every Canvas host the
# tool is launched from, so getting it wrong denies every launch. Unset means any site may embed.
#CSP_FRAME_ANCESTORS="https://canvas.example.com https://*.instructure.com"

# What the tool itself may embed, which is the opposite direction and unrelated to being framed
# by Canvas. Only needed if a page here shows something from another host in a frame.
#CSP_FRAME_SRC_ALLOW=""

# Sending is off here on purpose: these reach real people through Canvas Inbox, and an environment
# that is not meant to message anyone should say so rather than rely on nobody using it.
CONVERSATION_ROBOT_NAME="Canvas Conversation Robot"
CONVERSATION_ROBOT_API_TOKEN=""
CONVERSATION_ROBOT_SEND_MESSAGES=false

CACHE_CANVAS_API_SECONDS_TTL=60
CACHE_DB_SECONDS_TTL=60

# Ships log entries to a remote collector. Without all of BASEURL, USER and PWD the transport is
# not built and nothing is sent. SOURCE names the environment in the collector, and is the only
# log destination that can stay correct when deployments are swapped.
#LOGSTASH_BASEURL=""
#LOGSTASH_USER=""
#LOGSTASH_PWD=""
#LOGSTASH_SOURCE=""
